<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Base Info.plist. Xcode merges the generated keys (INFOPLIST_KEY_*)
	     on top of this at build time. We only need the launch-screen dict,
	     which build settings can't express: a deep indigo background so the
	     launch screen never flashes white before SplashView appears. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Supported UI languages. Arabic is the development language; English is
	     provided via Localization/en.lproj. Users switch in Settings (which then
	     prompts a restart so the whole bundle re-resolves). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
	</array>
</dict>
</plist>
