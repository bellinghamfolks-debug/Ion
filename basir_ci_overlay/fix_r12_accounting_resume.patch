+    private func handleTransportCancellation(jobID: UUID, logger: DiagnosticLogger) {
+        // URLSession may surface NSURLErrorCancelled (-999) when iOS suspends
+        // foreground polling or replaces a transport task. The server job is
+        // idempotent and continues independently, so this is not a conversion
+        // failure and must never turn a healthy server task red.
+        if pauseRequested || networkPauseRequested {
+            handleCancellation(jobID: jobID, logger: logger)
+            return
+        }
+        logger.record("TRANSPORT_CANCELLED resumable server task preserved")
+        guard let index = jobs.firstIndex(where: { $0.id == jobID }) else {
+            completeCurrentTaskAndContinue(allowNext: false)
+            return
+        }
+        jobs[index].status = .queued
+        jobs[index].automaticResumePending = true
+        jobs[index].progress = progressReplacingStage(jobs[index].progress, .paused)
+        jobs[index].errorMessage = l10n?.t(
+            "انقطعت متابعة الاتصال مؤقتًا، لكن مهمة الخادم محفوظة. سيعيد بصير الاتصال بنفس المهمة تلقائيًا دون إعادة التحويل من البداية.",
+            "Connection monitoring was interrupted, but the server task is preserved. Basir will reconnect to the same task automatically without restarting the conversion."
+        )
+        jobs[index].updatedAt = Date()
+        if let diagnostic = jobs[index].diagnosticURL { try? logger.write(to: diagnostic) }
+        persist()
+        syncFacade()
+        completeCurrentTaskAndContinue(allowNext: true)
+    }
