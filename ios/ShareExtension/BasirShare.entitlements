<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Same App Group as the host app (Basir/Basir.entitlements) so the
         extension's containerURL(forSecurityApplicationGroupIdentifier:)
         resolves and it can write the shared file for the app to read. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.basir.shared</string>
    </array>
</dict>
</plist>
