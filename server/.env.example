NODE_ENV=development

# Local / traditional PostgreSQL fallback:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/englishnova
PGSSL=disable

# Google Cloud SQL mode (preferred on Cloud Run). When these four are present,
# DATABASE_URL is not required.
DB_USER=englishnova
DB_PASS=
DB_NAME=englishnova
INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_ID
DB_POOL_MAX=8

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Optional Google Sign-In. Leave empty unless OAuth is configured in the app.
GOOGLE_SERVER_CLIENT_ID=

# Optional connected AI and administration features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ADMIN_TOKEN=
